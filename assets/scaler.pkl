ASSETS_DIR = 'assets'
SCALER_PATH = os.path.join(ASSETS_DIR, 'scaler.pkl')

# (Assuming X_train has been defined and contains your training features)

# --- 1. Initialize and Fit the Scaler ---
# The StandardScaler learns the mean and standard deviation from the training data (X_train)
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train) 
# X_test_scaled = scaler.transform(X_test) # (This line is for evaluation)

# --- 2. Save the Fitted Scaler Object ---
# This saves the 'scaler' object, which now holds the means and STDs, 
# for use in the Streamlit application.
os.makedirs(ASSETS_DIR, exist_ok=True)
joblib.dump(scaler, SCALER_PATH)

