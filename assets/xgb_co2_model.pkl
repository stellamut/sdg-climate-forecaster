# ==============================================================================
# CELL 3: MODEL TRAINING AND SAVING ARTIFACTS
# ==============================================================================

# --- Define Paths ---
ASSETS_DIR = 'assets'
MODEL_PATH = os.path.join(ASSETS_DIR, 'xgb_co2_model.pkl')
SCALER_PATH = os.path.join(ASSETS_DIR, 'scaler.pkl')

# Create the assets directory if it doesn't exist
os.makedirs(ASSETS_DIR, exist_ok=True)

# --- Train XGBoost Regressor ---
print("\nTraining XGBoost Regressor...")
model = XGBRegressor(
    n_estimators=200, 
    learning_rate=0.1, 
    max_depth=6, 
    random_state=42, 
    n_jobs=-1,
    subsample=0.7
)
model.fit(X_train_scaled, y_train)
print("Training Complete.")

# --- Evaluation (Optional but Recommended) ---
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
y_pred = model.predict(X_test_scaled)
rmse = np.sqrt(mean_squared_error(y_test, y_pred))
mae = mean_absolute_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)

print(f"\nModel Performance on Test Set:")
print(f"Root Mean Squared Error (RMSE): {rmse:,.0f} kt")
print(f"Mean Absolute Error (MAE): {mae:,.0f} kt")
print(f"R-squared (R²): {r2:.4f}")

# --- Save Model Artifacts ---
joblib.dump(model, MODEL_PATH)
joblib.dump(scaler, SCALER_PATH)

print(f"\n✅ Model and Scaler successfully saved to the '{ASSETS_DIR}/' directory.")